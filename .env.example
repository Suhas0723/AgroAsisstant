# Copy to .env for local development (never commit .env). On Vercel, set these in
# Project → Settings → Environment Variables.

FLASK_SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"

# Firebase Admin service account: paste the whole JSON (or a base64 copy of it).
# Locally you can instead set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase web app config (public by design; restrict the API key by HTTP referrer)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

OPENAI_API_KEY=
STORMGLASS_API_KEY=
WEATHERAPI_KEY=
TREFLE_API_KEY=
PLANT_ID_API_KEY=
GOOGLE_API_KEY=              # browser key (geocoding on signup) — restrict by referrer
GOOGLE_MAPS_API_KEY=         # browser key (plots map) — restrict by referrer

# Optional
AI_DAILY_LIMIT=60            # OpenAI calls allowed per user per day
FLASK_DEBUG=0
